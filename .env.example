PROJECT_NAME=Bina Insight
RAW_DATA_PATH=data/raw/responses_raw.csv
CLEANED_DATA_PATH=data/cleaned/responses_cleaned.csv
PROCESSED_DATA_DIR=data/processed

# NLP
# true = use full multilingual XLM-RoBERTa sentiment model
USE_TRANSFORMER=true

# Optional Claude API support
# false = use built-in Al Qua'a-specific recommendation engine
USE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
